<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.onthisdayapp.OnThisDayController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>

  <Label text="A rendszer egy random történelmi érdekességet ad vissza ami történt az a nap." />
   <Label text="Írj be egy dátumot, hogy elkezd!" />
    <HBox alignment="CENTER" spacing="10.0">
        <ComboBox fx:id="monthComboBox" promptText="Hónap" />
        <ComboBox fx:id="dayComboBox" promptText="Nap" />
    </HBox>
  <Button text="Lekérdezés" />
</VBox>
